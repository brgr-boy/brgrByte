[Unit]
Description=brgrByte Chef agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=brgrbyte
Group=brgrbyte
EnvironmentFile=/etc/brgrbyte/agent.env
ExecStart=/usr/bin/python3 /opt/brgrbyte/brgrbyte_agent.py
Restart=always
RestartSec=5
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
